# Google Cloud Platform Infrastructure Configuration
GCP_PROJECT_ID=""  # YOUR_GCP_PROJECT_ID
GCP_LOCATION=global  # e.g., us-central1
GCS_BUCKET_NAME=""  # YOUR_GCS_BUCKET_NAME

# Model Context Protocol (MCP) Server Configuration
MCP_SERVER_URL=""
MCP_USER=companies      # Default username for MCP server
MCP_PASSWORD=companies  # Default password for MCP server

# Neo4j Graph Database Secure Sandbox Injections
NEO4J_URI=bolt://localhost:7687 # e.g., bolt://<IP_ADDRESS>:7687
NEO4J_USER="neo4j"  # Default username for Neo4j
NEO4J_PASSWORD=""  # Default password for Neo4j
NEO4J_DATABASE="neo4j"  # Default database name for Neo4j