# Copy to .env and fill in your values.  Do NOT commit .env.
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=global
GCS_BUCKET_NAME=gs://your-agent-code-bucket

# Vertex AI Memory Bank (create one first — see README)
MEMORY_BANK_ID=your-reasoning-engine-id
MEMORY_BANK_LOCATION=global

# Neo4j MCP server
MCP_SERVER_URL=https://your-neo4j-mcp.run.app/mcp
MCP_USER=neo4j
MCP_PASSWORD=your-password

# Neo4j direct connection (used by the custom_investments skill)
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-password
NEO4J_DATABASE=neo4j