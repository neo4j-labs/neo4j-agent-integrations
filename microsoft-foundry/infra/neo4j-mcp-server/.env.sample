# Optional overrides. azd up prompts for environment name, subscription, and
# location on first run; copy this file to .env only when you need to change
# the defaults below.
#
# cp .env.sample .env

# Neo4j connection. Defaults connect to the public companies demo graph.
NEO4J_URI=neo4j+s://demo.neo4jlabs.com:7687
NEO4J_DATABASE=companies
NEO4J_USERNAME=companies
NEO4J_PASSWORD=companies

# Keep write tools disabled unless you are deliberately building a write-enabled agent.
NEO4J_READ_ONLY=true

# MCP server hosting blueprint. Pin the image to a tested tag for production.
NEO4J_MCP_CONTAINER_IMAGE=mcp/neo4j:latest
MCP_PORT=8000
MCP_EXTERNAL_INGRESS=true
MCP_MIN_REPLICAS=1
MCP_MAX_REPLICAS=3
MCP_CPU=0.5
MCP_MEMORY=1Gi
MCP_CONCURRENT_REQUESTS=20

# Neo4j MCP runtime knobs.
NEO4J_LOG_FORMAT=json
NEO4J_TELEMETRY=true
NEO4J_SCHEMA_SAMPLE_SIZE=100
NEO4J_MCP_HTTP_ALLOWED_ORIGINS=
