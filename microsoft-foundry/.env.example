# Microsoft Foundry + Neo4j shared environment.
#
# Two ways to populate this file:
#
#   1. Run infra/deploy.sh — it writes microsoft-foundry/.env with the
#      deployed Neo4j MCP endpoint, demo Neo4j creds, and the provisioned
#      Foundry account/project/model values (when you opt in at the prompt).
#
#   2. Copy this file to microsoft-foundry/.env and fill in your own values.
#      Useful when you already have a Foundry project and just want to point
#      examples at it.
#
# Every example script under microsoft-foundry/examples/* sources this file
# first, then layers any local .env in the example folder on top.
#
# This file carries endpoints and Neo4j Basic-auth creds only. Examples
# authenticate to Foundry via `az login` (AzureCliCredential pinned to
# AZURE_TENANT_ID below), so no Foundry tokens or keys live here.

# ---------------------------------------------------------------------------
# Neo4j connection — defaults connect to the public companies demo graph.
# ---------------------------------------------------------------------------
NEO4J_URI=neo4j+s://demo.neo4jlabs.com:7687
NEO4J_DATABASE=companies
NEO4J_USERNAME=companies
NEO4J_PASSWORD=companies

# ---------------------------------------------------------------------------
# Neo4j MCP server.
# Auto-filled by infra/deploy.sh after azd up.
# ---------------------------------------------------------------------------
NEO4J_MCP_ENDPOINT=https://<container-app-fqdn>/mcp

# ---------------------------------------------------------------------------
# Microsoft Foundry project.
# Auto-filled by infra/deploy.sh when you opt in to Foundry
# provisioning at the prompt. Set them yourself if you opted out and want to
# point examples at an existing Foundry project.
# ---------------------------------------------------------------------------
AZURE_SUBSCRIPTION_ID=<your-azure-subscription-id>
AZURE_TENANT_ID=<tenant-id-where-your-foundry-resource-lives>
FOUNDRY_RESOURCE_GROUP=<your-foundry-resource-group>
FOUNDRY_ACCOUNT_NAME=<your-foundry-ai-services-account>
FOUNDRY_PROJECT_NAME=<your-foundry-project>
FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
FOUNDRY_MODEL_DEPLOYMENT_NAME=gpt-4o-mini
FOUNDRY_EMBEDDING_DEPLOYMENT_NAME=text-embedding-3-small

# Set this after you add the Neo4j MCP server as a custom MCP tool in the
# Foundry portal — use whatever name you gave that connection.
NEO4J_MCP_CONNECTION_NAME=neo4j-mcp
