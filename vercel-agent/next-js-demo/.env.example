# ============================================================================
# AI Model Configuration
# ============================================================================
# Choose one: OPENAI_API_KEY or GOOGLE_GENERATIVE_AI_API_KEY

# OpenAI Configuration
OPENAI_API_KEY="your-openai-key-here"
# AI_MODEL="gpt-4o-mini"  # Optional: override default model
# AI_PROVIDER="openai"    # Optional: force OpenAI provider

# OR Google Gemini Configuration
# GOOGLE_GENERATIVE_AI_API_KEY="your-google-key-here"
# AI_MODEL="gemini-2.5-flash"      # Optional: override default model
# AI_PROVIDER="google"              # Optional: force Google provider

# ============================================================================
# Neo4j Configuration (for chat & entity search)
# ============================================================================
# By default, uses the public Neo4j demo database with company/news data:
#   URI: neo4j+s://demo.neo4jlabs.com:7687
#   USERNAME: companies
#   PASSWORD: companies
#   DATABASE: companies

# Optional: Override with your own Neo4j instance
# NEO4J_URI="neo4j+s://your-instance:7687"
# NEO4J_USERNAME="your_username"
# NEO4J_PASSWORD="your_password"
# NEO4J_DATABASE="your_database"

# ============================================================================
# Neo4j Agent Memory Service (NAMS) Configuration (Optional)
# ============================================================================
# To enable persistent memory, provide an API key from memory.neo4jlabs.com
# If MEMORY_API_KEY is not set, memory features will be disabled gracefully.

# Get your API key at: https://memory.neo4jlabs.com
MEMORY_API_KEY="nams_your_api_key_here"

# Optional: Override the NAMS endpoint (defaults to https://memory.neo4jlabs.com/v1)
# MEMORY_ENDPOINT="https://memory.neo4jlabs.com/v1"

# ============================================================================
# Corporate Proxy / SSL Configuration (Optional)
# ============================================================================
# If your machine uses a corporate SSL proxy (e.g. Zscaler), Node.js may not
# trust the proxy's root CA. Export the CA cert and point NODE_EXTRA_CA_CERTS
# to it. On macOS with Zscaler:
#   security find-certificate -a -c "Zscaler" -p /Library/Keychains/System.keychain > zscaler-certs.pem
# The npm scripts already include NODE_EXTRA_CA_CERTS=./zscaler-certs.pem if
# that file is present. The file is gitignored (*.pem rule).

# ============================================================================
# Demo Configuration
# ============================================================================
DEMO_AGENT_ID="vercel-neo4j-research-agent"
