# ============================================================================
# AI Model Configuration
# ============================================================================
# Choose one: OPENAI_API_KEY or GOOGLE_GENERATIVE_AI_API_KEY

# OpenAI Configuration
OPENAI_API_KEY="your-openai-key-here"
# AI_MODEL="gpt-4o-mini"  # Optional: override default model
# AI_PROVIDER="openai"    # Optional: force OpenAI provider

# OR Google Gemini Configuration
# GOOGLE_GENERATIVE_AI_API_KEY="your-google-key-here"
# AI_MODEL="gemini-2.5-flash"      # Optional: override default model
# AI_PROVIDER="google"              # Optional: force Google provider

# ============================================================================
# Neo4j Configuration (for chat & entity search)
# ============================================================================
# By default, uses the public Neo4j demo database with company/news data:
#   URI: neo4j+s://demo.neo4jlabs.com:7687
#   USERNAME: companies
#   PASSWORD: companies
#   DATABASE: companies

# Optional: Override with your own Neo4j instance
# NEO4J_URI="neo4j+s://your-instance:7687"
# NEO4J_USERNAME="your_username"
# NEO4J_PASSWORD="your_password"
# NEO4J_DATABASE="your_database"

# ============================================================================
# Neo4j Agent Memory Configuration (Optional)
# ============================================================================
# To enable persistent memory, set up a separate Neo4j instance.
# If not set, memory features will be disabled.

# Option A: Use the same Neo4j instance as chat
# MEMORY_NEO4J_URI="neo4j+s://demo.neo4jlabs.com:7687"
# MEMORY_NEO4J_USERNAME="companies"
# MEMORY_NEO4J_PASSWORD="companies"
# MEMORY_NEO4J_DATABASE="companies"

# Option B: Use a separate instance for memory
# MEMORY_NEO4J_URI="neo4j+s://memory-instance:7687"
# MEMORY_NEO4J_USERNAME="memory_user"
# MEMORY_NEO4J_PASSWORD="memory_pass"
# MEMORY_NEO4J_DATABASE="memory"

# Memory index names (keep defaults unless customized)
# MEMORY_VECTOR_INDEX="memoryEmbedding"
# MEMORY_FULLTEXT_INDEX="memoryText"

# ============================================================================
# Demo Configuration
# ============================================================================
DEMO_AGENT_ID="vercel-neo4j-research-agent"
