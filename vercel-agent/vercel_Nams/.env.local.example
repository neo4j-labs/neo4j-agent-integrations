# ── NAMS (Neo4j Agent Memory System) ──────────────────────────────────────────
# Get a free API key at https://memory.neo4jlabs.com
MEMORY_API_KEY=your-nams-api-key

# Optional: pin to a specific workspace (leave blank to use the default)
MEMORY_WORKSPACE_ID=

# Optional: override the NAMS endpoint (default: https://memory.neo4jlabs.com/v1)
# MEMORY_ENDPOINT=https://memory.neo4jlabs.com/v1

# ── OpenAI ─────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# Optional: override the model (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o
