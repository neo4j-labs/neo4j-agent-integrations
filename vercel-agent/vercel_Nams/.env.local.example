# ── NAMS (Neo4j Agent Memory System) ─────────────────────────────────────────
# Get a free API key at https://memory.neo4jlabs.com
MEMORY_API_KEY=your-nams-api-key

# Optional: pin to a specific workspace (leave blank to use the default)
MEMORY_WORKSPACE_ID=

# Optional: override the NAMS endpoint (default: https://memory.neo4jlabs.com/v1)
# MEMORY_ENDPOINT=https://memory.neo4jlabs.com/v1

# ── Integration mode ──────────────────────────────────────────────────────────
# Choose how NAMS is wired into the Vercel AI SDK:
#
#   provider  (default) — createNams().wrap(model, scope)
#     Transparent LanguageModelV3Middleware. Memory is retrieved and injected
#     into the system prompt before every call; the turn is persisted after.
#     The model never sees tool definitions — no tools: field needed.
#     Best for: most apps. Deterministic, runs every turn, like Mem0.
#
#   tools — createNams().tools(scope)
#     Exposes query_memory + store_memory as AI SDK tool()s. The model
#     decides when to call them. Tool-call trace is visible in the UI.
#     Best for: when you want the model to decide when memory matters,
#     or need the tool-call trace surfaced in your UI, like Supermemory.
#
NAMS_MODE=provider

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# Optional: override the model (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o
