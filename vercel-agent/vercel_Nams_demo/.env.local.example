# ── Required 

# NAMS API key — free key from https://memory.neo4jlabs.com
MEMORY_API_KEY=nams_...

# OpenAI API key — read by @ai-sdk/openai
OPENAI_API_KEY=sk-proj-...


# ── Integration mode 

# provider   (default) createNamsProvider().languageModel() — transparent memory
# middleware           createNams().wrap(model, scope)      — transparent memory
# tools                createNams().toolsWithMcp(scope)     — model-driven memory
NAMS_MODE=provider


# ── Optional NAMS 

# Pin to a specific NAMS workspace. Leave blank for the key's default workspace.
MEMORY_WORKSPACE_ID=

# Defaults to gpt-5.4-mini. A larger model (e.g. gpt-5.4) is more reliable at
# multi-tool cycles in tools mode.
OPENAI_MODEL=gpt-5.4-mini


# ── Optional MCP — live Neo4j database access 
#
# MCP stays disabled unless a URL *and* one auth pair below are set.
# Not sure which auth your server wants?
#   curl -i -X POST $MCP_URL
# and read the WWW-Authenticate header: `Bearer …` = token, `Basic …` = user/pass.

# Remote MCP server URL...
MCP_URL=

# ...or a local server, used as http://localhost:{MCP_PORT}/mcp when MCP_URL is unset.
MCP_PORT=

# Auth — pick ONE pair. Bearer wins when both are present.

# OAuth 2.1 servers (hosted Aura / NeoCompanion endpoints)
MCP_BEARER_TOKEN=

# Basic auth (self-hosted mcp-neo4j-cypher behind a proxy)
MCP_NEO4J_USERNAME=
MCP_NEO4J_PASSWORD=
