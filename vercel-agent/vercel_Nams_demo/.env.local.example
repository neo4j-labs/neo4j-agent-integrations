# ── Required 

# NAMS API key — free key from https://memory.neo4jlabs.com
MEMORY_API_KEY=nams_...

# OpenAI API key — read by @ai-sdk/openai
OPENAI_API_KEY=sk-proj-...


# ── Optional NAMS 

# Pin to a specific NAMS workspace (a UUID). Leave blank for the key's own
# workspace. A key bound to a different workspace gets 403 on every call.
MEMORY_WORKSPACE_ID=

# Defaults to gpt-5.6-luna. A larger model (e.g. gpt-5.6-terra) is more reliable at
# multi-tool cycles in tools mode.
OPENAI_MODEL=gpt-5.6-luna

# Entity extraction (tools mode only) — when set, every memory stored through
# store_memory is split into graph entities and the edges between them, e.g.
# "Alex works at TechCorp" becomes (Alex)-[WORKS_AT]->(TechCorp). NAMS stores an
# edge type outside the workspace's allowlist as RELATED_TO. Costs one extra
# model call per stored memory. The route passes it in tools mode only. Leave
# blank to store each memory as one flat entity (the package default).
NAMS_EXTRACTION_MODEL=gpt-5.6-luna


# ── Optional MCP — live Neo4j database access 
#
# MCP stays disabled unless a URL *and* one auth pair below are set.
# Not sure which auth your server wants?
#   curl -i -X POST $MCP_URL
# and read the WWW-Authenticate header: `Bearer …` = token, `Basic …` = user/pass.

# Remote MCP server URL...
MCP_URL=

# ...or a local server, used as http://localhost:{MCP_PORT}/mcp when MCP_URL is unset.
MCP_PORT=

# Auth — pick ONE pair. Bearer wins when both are present.

# OAuth 2.1 servers (hosted Aura / NeoCompanion endpoints)
MCP_BEARER_TOKEN=

# Basic auth (self-hosted mcp-neo4j-cypher behind a proxy)
MCP_NEO4J_USERNAME=
MCP_NEO4J_PASSWORD=
