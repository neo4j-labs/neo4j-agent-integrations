# ── Required

# NAMS API key, free at https://memory.neo4jlabs.com
NAMS_API_KEY=nams_...

# OpenAI API key
OPENAI_API_KEY=sk-proj-...


# ── Optional NAMS

# Workspace UUID; leave blank to use the key's own workspace
MEMORY_WORKSPACE_ID=

# Chat model (gpt-5.6-terra is more reliable in tools mode)
OPENAI_MODEL=gpt-5.6-luna

# Tools mode only: splits stored memories into graph entities; blank = off
NAMS_EXTRACTION_MODEL=gpt-5.6-luna


# ── Optional MCP (needs a URL and one auth pair)

# Remote MCP server URL
MCP_URL=

# Local server port, used when MCP_URL is blank
MCP_PORT=

# Bearer token for OAuth servers (wins over basic auth)
MCP_BEARER_TOKEN=

# Basic auth username and password
MCP_NEO4J_USERNAME=
MCP_NEO4J_PASSWORD=
