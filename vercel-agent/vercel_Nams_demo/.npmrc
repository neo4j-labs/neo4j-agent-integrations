# @neo4j-labs/nams-ai-provider@0.1.0 (the only version published to npm)
# declares a peerDependency on zod@~3.0.0, narrower than the zod@^3.25.x used
# here and across the AI SDK ecosystem. It works correctly with 3.25.x in
# practice — this is just an overly strict peer range upstream — so relax
# npm's peer resolution instead of requiring every consumer to remember
# `--legacy-peer-deps` on every install.
legacy-peer-deps=true
