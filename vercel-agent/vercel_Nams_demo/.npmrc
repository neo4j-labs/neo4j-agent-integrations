# @neo4j-ndl/react declares a peerDependency on react >=19.0.0, while this demo
# runs React 18 on Next.js 14. The NDL components work correctly on React 18 in
# practice, so we relax npm's peer resolution here instead of forcing every
# consumer to remember `--legacy-peer-deps` on every install.
#
# Note: the AI SDK is NOT the reason. @ai-sdk/react@4 accepts
# `react ^18 || ~19.0.1 || ~19.1.2 || ^19.2.1`, so it is satisfied by React 18.
legacy-peer-deps=true
