# @neo4j-labs/nams-ai-provider@0.1.0 declares a peerDependency on zod@~3.0.0,
# which excludes the zod@^3.25.x this project (and the rest of the AI SDK
# ecosystem) actually uses. The package works correctly with zod 3.25.x in
# practice — this is just an overly strict peer range upstream — so we relax
# npm's peer resolution here instead of forcing every consumer to remember
# `--legacy-peer-deps` on every install.
legacy-peer-deps=true
