# ── LLM provider: set AI_PROVIDER and its API key

# OpenAI (default)
AI_PROVIDER=openai
AI_MODEL=gpt-5.6-luna
OPENAI_API_KEY=your-openai-api-key

# Google Gemini (optional dependency)
# AI_PROVIDER=google
# AI_MODEL=gemini-flash-latest
# GOOGLE_GENERATIVE_AI_API_KEY=your-google-api-key

# Anthropic Claude (optional dependency)
# AI_PROVIDER=anthropic
# AI_MODEL=claude-opus-5-5
# ANTHROPIC_API_KEY=your-anthropic-api-key

# Mistral (optional dependency)
# AI_PROVIDER=mistral
# AI_MODEL=mistral-large-latest
# MISTRAL_API_KEY=your-mistral-api-key

# ── Neo4j demo database (read-only), used by scripts 0 and 2
NEO4J_URI=neo4j+s://demo.neo4jlabs.com:7687
NEO4J_USERNAME=companies
NEO4J_PASSWORD=companies
NEO4J_DATABASE=companies

# ── Neo4j MCP server: MCP_URL for a hosted server, or MCP_PORT for a local one
MCP_URL=https://your-hosted-mcp-server.example.com/mcp
MCP_PORT=8443
# Bearer token for OAuth servers (wins over basic auth)
# MCP_BEARER_TOKEN=your-oauth-access-token
# Basic auth; falls back to NEO4J_USERNAME / NEO4J_PASSWORD
# MCP_NEO4J_USERNAME=neo4j
# MCP_NEO4J_PASSWORD=your-password

# ── NAMS memory (scripts 3 and 4), free key at https://memory.neo4jlabs.com
NAMS_API_KEY=nams_your-api-key-here
# MEMORY_WORKSPACE_ID=           # optional: blank = the key's own workspace
# MEMORY_ENDPOINT=https://memory.neo4jlabs.com/v1   # optional: custom endpoint
DEMO_USER_ID=vercel-neo4j-notebook-agent
