# ──────────────────────────────────────────────────────────────────────────────
# LLM Provider  — set AI_PROVIDER + the matching API key
# ──────────────────────────────────────────────────────────────────────────────

# OpenAI (default)
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=your-openai-api-key

# Google Gemini  →  npm install @ai-sdk/google
# AI_PROVIDER=google
# AI_MODEL=gemini-2.0-flash
# GOOGLE_GENERATIVE_AI_API_KEY=your-google-api-key

# Anthropic Claude  →  npm install @ai-sdk/anthropic
# AI_PROVIDER=anthropic
# AI_MODEL=claude-3-5-sonnet-20241022
# ANTHROPIC_API_KEY=your-anthropic-api-key

# Mistral  →  npm install @ai-sdk/mistral
# AI_PROVIDER=mistral
# AI_MODEL=mistral-large-latest
# MISTRAL_API_KEY=your-mistral-api-key

# ──────────────────────────────────────────────────────────────────────────────
# Neo4j — Graph Data  (demo read-only database)
# Used by the direct driver in 0-direct-query.mjs and the custom tool in
# 2-custom-tools-agent.mjs. Not used to reach the MCP server — see below.
# ──────────────────────────────────────────────────────────────────────────────
NEO4J_URI=neo4j+s://demo.neo4jlabs.com:7687
NEO4J_USERNAME=companies
NEO4J_PASSWORD=companies
NEO4J_DATABASE=companies

# ──────────────────────────────────────────────────────────────────────────────
# Neo4j MCP Server  — same variables as ../vercel_Nams_demo
#
# Endpoint: set MCP_URL for a hosted server, or MCP_PORT for a local
#           neo4j-mcp-server (resolves to http://localhost:${MCP_PORT}/mcp).
#
# Auth:     MCP_BEARER_TOKEN                          → Bearer (OAuth 2.1 servers;
#                                                       hosted Aura / NeoCompanion
#                                                       endpoints require this)
#           MCP_NEO4J_USERNAME + MCP_NEO4J_PASSWORD   → Basic (self-hosted
#                                                       mcp-neo4j-cypher behind a proxy)
#           Bearer wins when both are present. The Basic pair falls back to
#           NEO4J_USERNAME / NEO4J_PASSWORD above when unset.
# ──────────────────────────────────────────────────────────────────────────────
MCP_URL=https://your-hosted-mcp-server.example.com/mcp
MCP_PORT=8443
# MCP_BEARER_TOKEN=your-oauth-access-token
# MCP_NEO4J_USERNAME=neo4j
# MCP_NEO4J_PASSWORD=your-password

# ──────────────────────────────────────────────────────────────────────────────
# Neo4j Agent Memory Service (NAMS)  — 3-memory-agent.mjs & 4-nams-provider-agent.mjs
# Get a free API key at https://memory.neo4jlabs.com
# ──────────────────────────────────────────────────────────────────────────────
MEMORY_API_KEY=nams_your-api-key-here
# MEMORY_WORKSPACE_ID=ws_...     # optional: leave blank for the key's default workspace
# MEMORY_ENDPOINT=https://memory.neo4jlabs.com/v1   # optional: override default endpoint
DEMO_USER_ID=vercel-neo4j-notebook-agent

# NAMS integration mode for 4-nams-provider-agent.mjs:
#   provider (default) | middleware | tools
NAMS_MODE=provider
