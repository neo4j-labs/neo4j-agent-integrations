
OPENAI_API_KEY=sk-...

# ── NAMS Memory (required)
# Neo4j Agent Memory Service API key – used for all conversation storage & retrieval.
MEMORY_API_KEY=
MEMORY_WORKSPACE_ID=

# ── MCP Tools (optional)
# Connect to any MCP server to give the agent additional tools.
# When configured, the agent can call MCP tools alongside answering from NAMS memory.
# MCP_URL=https://your-mcp-server.com/mcp
# MCP_NEO4J_USERNAME=
# MCP_NEO4J_PASSWORD=
