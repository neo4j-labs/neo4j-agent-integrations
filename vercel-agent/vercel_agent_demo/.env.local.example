
OPENAI_API_KEY=sk-...

# ── Memory transport: choose ONE of the two options below ────────────────────

# Option A: SDK transport (API key)
# Set MEMORY_API_KEY to use the @neo4j-labs/agent-memory SDK directly.
# MEMORY_API_KEY=
# Optional: override the REST endpoint (defaults to https://memory.neo4jlabs.com/v1)
# MEMORY_ENDPOINT=https://memory.neo4jlabs.com/v1

# Option B: MCP transport (StreamableHTTP + Basic auth)
# Set NEO4J_USERNAME and NEO4J_PASSWORD to connect via MCP instead.
# Takes precedence over Option A when both sets of credentials are present.
# MEMORY_TRANSPORT=mcp
# NEO4J_USERNAME=''
# NEO4J_PASSWORD=''
# Optional: override the MCP endpoint (defaults to https://memory.neo4jlabs.com/mcp)
# MCP_URL=
# Optional: override the REST endpoint used for conversation delete in MCP mode
# MEMORY_REST_URL=https://memory.neo4jlabs.com/v1
