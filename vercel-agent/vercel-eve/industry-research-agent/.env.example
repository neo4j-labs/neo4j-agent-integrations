# --- Required ---

# Neo4j Agent Memory key (free at https://memory.neo4jlabs.com).
NAMS_API_KEY=nams_...

# Set one model key: Vercel AI Gateway (not needed when deployed on Vercel)...
AI_GATEWAY_API_KEY=
# ...or OpenAI directly.
OPENAI_API_KEY=

# --- Optional (defaults in code) ---

# Leave blank to use the key's workspace. A wrong id quietly breaks memory.
#NAMS_WORKSPACE_ID=

# Self-hosted NAMS endpoint.
#NAMS_ENDPOINT=

#NAMS_MAX_MEMORIES=6

# Record reasoning steps and tool calls (`off` disables).
#NAMS_REASONING=on

# Save turns to the long-term graph (`off` disables).
#NAMS_GRAPH_MEMORY=on

# Model that pulls entities out of chats; defaults to AGENT_MODEL.
#NAMS_EXTRACTION_MODEL=openai/gpt-5.4-mini

# How many users' memory clients to keep cached.
#NAMS_CLIENT_CACHE=250

#NAMS_MCP_URL=https://memory.neo4jlabs.com/mcp

#AGENT_MODEL=openai/gpt-5.4

# `gateway` or `openai`. Blank picks based on which key is set.
#MODEL_ROUTING=

#EVAL_JUDGE_MODEL=openai/gpt-5.4-mini

# Direct database connection for search_news.
#NEO4J_URI=neo4j+s://demo.neo4jlabs.com:7687
#NEO4J_USERNAME=
#NEO4J_PASSWORD=
#NEO4J_DATABASE=

# Neo4j MCP server (get-schema, read-cypher, list-gds-procedures).
#MCP_URL=https://neo4j-mcp-official-1008050579172.us-central1.run.app/mcp
#MCP_NEO4J_USERNAME=
#MCP_NEO4J_PASSWORD=

# Local MCP server in mcp-server/ (get_investments). Port and path must match the URL.
#INVESTMENTS_MCP_URL=http://localhost:8100/mcp
#INVESTMENTS_MCP_PORT=8100
#INVESTMENTS_MCP_PATH=/mcp
#MCP_TRANSPORT=http

# Local dev user id for `eve dev` / `eve invoke`.
#DEMO_USER_ID=local-analyst
