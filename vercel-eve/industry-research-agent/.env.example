# ---------------------------------------------------------------------------
# Required — the agent will not start without these
# ---------------------------------------------------------------------------

# Neo4j Agent Memory key. Free at https://memory.neo4jlabs.com — this is the
# memory layer; without it every recall and store throws at startup.
NAMS_API_KEY=nams_...

# ONE model credential. AI_GATEWAY_API_KEY is a Vercel key (dashboard → AI
# Gateway → API Keys) that routes to any id on https://vercel.com/ai-gateway/models,
# so AGENT_MODEL works without a provider key. Deployed on Vercel, project OIDC
# covers this and neither line is needed.
AI_GATEWAY_API_KEY=
# ...or talk to OpenAI directly, no Vercel account required.
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Optional — every line below has a working default in code. Uncomment to change.
# ---------------------------------------------------------------------------

# NAMS workspace. Blank uses the one your key is bound to; a WRONG id 403s every
# memory call silently while answers still stream. Use a FRESH workspace —
# entities carry no user id, so a shared one leaks other people's facts.
#NAMS_WORKSPACE_ID=

# Self-hosted NAMS. Point at NAMS running against your own Neo4j and memory
# lands in the same database as your domain data (README, "Co-locating memory").
#NAMS_ENDPOINT=

# Memories injected into the prompt per turn.
#NAMS_MAX_MEMORIES=6

# Record reasoning steps and tool calls. Costs one round trip per turn; `off` disables.
#NAMS_REASONING=on

# Promote each completed turn into the long-term entity graph. Costs one
# extraction model call per turn, paid after the answer streams; `off` disables.
#NAMS_GRAPH_MEMORY=on

# Model for that extraction. Defaults to AGENT_MODEL; a cheaper id pays off here.
#NAMS_EXTRACTION_MODEL=openai/gpt-5.4-mini

# Per-user MemoryClients the gateway keeps warm (LRU).
#NAMS_CLIENT_CACHE=256

# NAMS's MCP server, mounted read-only so the model can traverse its own memory.
#NAMS_MCP_URL=https://memory.neo4jlabs.com/mcp

# Any Vercel AI Gateway model id.
#AGENT_MODEL=openai/gpt-5.4

# `gateway` or `openai`. Inferred from whichever credential is present; set to override.
#MODEL_ROUTING=

# Judge model for `npx eve eval`.
#EVAL_JUDGE_MODEL=openai/gpt-5.4-mini

# The public `companies` demo graph, read over Bolt by the search_news tool.
#NEO4J_URI=neo4j+s://demo.neo4jlabs.com:7687
#NEO4J_USERNAME=companies
#NEO4J_PASSWORD=companies
#NEO4J_DATABASE=companies

# The same graph over MCP — supplies get-schema / read-cypher / list-gds-procedures.
#MCP_URL=https://neo4j-mcp-official-1008050579172.us-central1.run.app/mcp
#MCP_NEO4J_USERNAME=companies
#MCP_NEO4J_PASSWORD=companies

# Local development only: the "who am I" for `eve dev` and `eve invoke`, since
# localDev() yields no user principal. In production this comes from channel auth.
#DEMO_USER_ID=local-analyst

# Slack channel (agent/channels/slack.ts). Read by eve, not by project code.
# Only matters on a deployment — Slack must reach a public URL.
#SLACK_BOT_TOKEN=
#SLACK_SIGNING_SECRET=
