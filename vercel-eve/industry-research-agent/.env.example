
# Free key: https://memory.neo4jlabs.com
NAMS_API_KEY=nams_...

NAMS_WORKSPACE_ID=

# Memories injected per turn (default 6).
NAMS_MAX_MEMORIES=6

# How many per-user memory clients the MemoryGateway keeps warm (default 256).
#NAMS_CLIENT_CACHE=256

# Record the agent's reasoning steps and tool calls to NAMS reasoning memory.
# Nothing else writes reasoning, so this never double-stores a turn. Costs one
# extra round trip per turn. Set to `off` to disable.
NAMS_REASONING=on

# ---------------------------------------------------------------------------
# Model
# ---------------------------------------------------------------------------
# Any Vercel AI Gateway model id: https://vercel.com/ai-gateway/models
AGENT_MODEL=openai/gpt-5.4

# Needed locally. `eve link` writes VERCEL_OIDC_TOKEN here instead, and a
# deployed agent authenticates through project OIDC with neither set.
#AI_GATEWAY_API_KEY is a Vercel AI Gateway key — it's issued by Vercel, not by Neo4j or by the model provider. It's one key that routes to any model id on https://vercel.com/ai-gateway/models (that's why AGENT_MODEL=openai/gpt-5.4 works without an OpenAI key).
#To get one:
#Sign in at https://vercel.com (free account is fine).
#Go to the AI Gateway tab in the dashboard — https://vercel.com/dashboard/ai-gateway — or open your team's settings.
#API Keys → Create key, copy the vck_... value into .env.local.
AI_GATEWAY_API_KEY=
# OR 
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Knowledge graph
# ---------------------------------------------------------------------------
# Defaults to the public Neo4j demo instance; override for your own database.
NEO4J_URI=neo4j+s://demo.neo4jlabs.com:7687
NEO4J_USERNAME=companies
NEO4J_PASSWORD=companies
NEO4J_DATABASE=companies

# Bridge edges: on = the database above is yours and writable, so `writeQuery`
# in lib/neo4j.ts will MERGE (:User)-[:TRACKS]->(:Organization) edges. Nothing
# calls it at the moment — the tools that did (track_interest / daily_brief)
# are not registered — so this only matters when you wire lib/bridge.ts back up
# to a tool. Leave off for the shared demo instance.
NEO4J_BRIDGE=off

# ---------------------------------------------------------------------------
# Connections (optional)
# ---------------------------------------------------------------------------
# NAMS's MCP server, mounted read-only as agent/connections/memory-graph.ts so
# the model can traverse its own memory graph. Uses NAMS_API_KEY as the bearer.
NAMS_MCP_URL=https://memory.neo4jlabs.com/mcp

# Local development only
DEMO_USER_ID=local-analyst
