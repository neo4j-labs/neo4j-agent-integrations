# Copy to .env and fill in the values. .env is git-ignored.
#   cp env.sample .env

# ---- Neo4j Aura -------------------------------------------------------------
# From the credentials file Aura downloads when the instance is created.
NEO4J_URI=neo4j+s://<instance-id>.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=<aura-password>
NEO4J_DATABASE=neo4j

# ---- OpenAI (Phases 1 to 3) -------------------------------------------------
# The agent and the local vector-only baseline both use OPENAI_CHAT_MODEL,
# so the beat 1 comparison is fair.
OPENAI_API_KEY=<openai-api-key>
OPENAI_CHAT_MODEL=gpt-5.6-terra
# text-embedding-3-small returns 1536 dimensions, which sets the vector index size.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---- Demo -------------------------------------------------------------------
# Fixed "today" for the demo. "Yesterday" and "this morning" resolve from it.
DEMO_AS_OF=2026-10-08
# The signed-in customer. Tools read it from config, never from the LLM.
DEMO_CUSTOMER_ID=C-1001
# The signed-in banker for the staff tools. Tools read it from config, never
# from the LLM.
DEMO_BANKER_ID=RM-07
# Seed for the synthetic data generator.
DATA_SEED=42

# ---- watsonx Orchestrate (Phase 5) ------------------------------------------
# From Settings > API details in your Orchestrate instance. `make wxo-env`
# adds and activates the environment with these values.
WO_ENV_NAME=<env-name>
WO_INSTANCE_URL=<service-instance-url>
WO_API_KEY=<orchestrate-api-key>
# Optional. The ADK picks the auth type from the URL. Set this only when that
# guess is wrong: ibm_iam, mcsp, mcsp_v1, mcsp_v2, cpd, or k8s.
# WO_AUTH_TYPE=ibm_iam
