# ---- watsonx Orchestrate ----------------------------------------------------
# Settings -> API details in the Orchestrate console
WO_ENV_NAME=trial
WO_INSTANCE_URL=https://api.<region>.watson-orchestrate.ibm.com/instances/<instance-id>
WO_API_KEY=<wxo-api-key>

# ---- Neo4j ------------------------------------------------------------------
# Defaults target the public Neo4j "companies" demo database.
# Swap these for an Aura or self-managed instance.
NEO4J_URI=neo4j+s://demo.neo4jlabs.com:7687
NEO4J_USERNAME=companies
NEO4J_PASSWORD=companies
NEO4J_DATABASE=companies
NEO4J_READ_ONLY=true

# ---- Orchestrate object names ----------------------------------------------
CONNECTION_APP_ID=neo4j_local_creds
MCP_TOOLKIT_NAME=neo4j_local_mcp
AGENT_NAME=neo4j_explorer