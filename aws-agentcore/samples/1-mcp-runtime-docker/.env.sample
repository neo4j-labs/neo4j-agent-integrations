# Neo4j connection settings (used by deploy.sh for CDK)
NEO4J_URI=neo4j+s://demo.neo4jlabs.com:7687
NEO4J_DATABASE=neo4j

# Neo4j credentials (used by demo client — passed per-request via custom auth header)
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=neo4j

# Neo4j MCP container image URI (optional)
# If set, deploys the pre-built image. If unset, CDK builds from docker/Dockerfile.
# See AWS Marketplace for available pre-built Neo4j MCP container images.
# NEO4J_MCP_CONTAINER_URI=<your-ecr-image-uri>

# AWS settings (optional — defaults to AWS CLI profile/environment)
# AWS_PROFILE=default
# AWS_REGION=us-east-1

# Bedrock model used by the demo agent (optional — defaults to Haiku 4.5)
# Pick one (US cross-region inference profile IDs):
# BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0    # fast/cheap (default)
# BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0   # balanced
# BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6                 # newer Sonnet (1M context)
# BEDROCK_MODEL_ID=us.anthropic.claude-opus-4-7                   # most capable

# CDK stack name (optional — defaults to Neo4jMCPRuntimeStack)
# STACK_NAME=Neo4jMCPRuntimeStack

# Auto-populated by deploy.sh after successful deployment
# AGENTCORE_RUNTIME_ARN=
