# Copy to .env. The screencast signs in to Snowsight as this user.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
# The screencast generates MFA codes from this Base32 TOTP secret.
SNOWFLAKE_OTP_SECRET_KEY=

# Comma-separated text to blur in the recording, e.g. the account locator.
# The personal database USER$... is always blurred.
SCREENCAST_BLUR=
