set -eu
cd "${model_dir}"

if [ ! -d "minilm" ]; then
  echo "Downloading sentence transformer model..."
  python3 -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('all-MiniLM-L6-v2').save('./minilm')"
fi

"$${SNOW:-snow}" stage copy minilm "@${stage}/minilm" \
  --recursive --overwrite --no-auto-compress \
  --temporary-connection \
  --account "${account}" \
  --user "${service_user}" \
  --authenticator SNOWFLAKE_JWT \
  --private-key-file "${private_key_path}" \
  --role TERRAFORM_SVC
