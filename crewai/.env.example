# ==============================================================================
# CrewAI + Neo4j Agent Integrations Configuration
# ==============================================================================

# ── LLM Configuration ────────────────────────────────────────────────────────
# CrewAI uses LiteLLM under the hood. You can specify any model supported by LiteLLM:
# e.g., gpt-4o, gpt-4o-mini, anthropic/claude-3-5-sonnet-20241022, ollama/llama3
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL_NAME=gpt-4o-mini

# ── Neo4j Knowledge Graph ────────────────────────────────────────────────────
# Public demo database (Companies dataset) ready to use out-of-the-box:
NEO4J_URI=neo4j+s://demo.neo4jlabs.com:7687
NEO4J_USERNAME=companies
NEO4J_PASSWORD=companies
NEO4J_DATABASE=companies

# ── Neo4j Agent Memory Server (NAMS) — optional ──────────────────────────────
# Cross-session long-term memory & shared multi-agent context graph.
# Leave blank to run crew with native local execution without NAMS.
# Get API key & workspace ID at https://memory.neo4jlabs.com
MEMORY_API_KEY=
MEMORY_WORKSPACE_ID=

# ── MCP (Model Context Protocol) — optional ──────────────────────────────────
# Connect CrewAI agents to external tools via MCP (HTTP, SSE, or stdio).
# Leave MCP_SERVER_URL blank to disable MCP tool loading.
#
# Examples:
#   Official Neo4j MCP:    MCP_SERVER_URL=https://neo4j-mcp-official-1008050579172.us-central1.run.app/mcp
#   Aura Hosted Database:  MCP_SERVER_URL=<URL from Aura Console "Inspect" tab>
#   Aura Agent Invoke:     MCP_SERVER_URL=https://api.neo4j.io/v2beta1/organizations/<org>/projects/<proj>/agents/<id>/invoke
#   Local stdio server:    MCP_SERVER_URL=uvx neo4j-agent-memory[mcp] mcp serve --password secret
MCP_SERVER_URL=

# MCP Auth (if required):
# 1) Hosted Neo4j Aura MCP OAuth (Client Credentials Grant):
MCP_OAUTH_CLIENT_ID=
MCP_OAUTH_CLIENT_SECRET=
MCP_OAUTH_TOKEN_URL=
MCP_OAUTH_SCOPE=
MCP_OAUTH_AUDIENCE=

# 2) Static Bearer Token:
MCP_AUTH_TOKEN=

# MCP Timeout (seconds)
MCP_HTTP_TIMEOUT=90

# ── CrewAI Execution Settings ────────────────────────────────────────────────
CREW_VERBOSE=true
CREW_PROCESS=sequential
