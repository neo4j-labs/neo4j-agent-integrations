# ==============================================================================
# CrewAI + Neo4j Agent Integrations Configuration
# ==============================================================================

# ── LLM Configuration ────────────────────────────────────────────────────────
# CrewAI uses LiteLLM under the hood. You can specify any model supported by LiteLLM:
# e.g., gpt-5.4-mini, anthropic/claude-3-5-sonnet-20241022, ollama/llama3
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL_NAME=gpt-5.4-mini

# ── Neo4j Knowledge Graph ────────────────────────────────────────────────────
# Public demo database (Companies dataset) ready to use out-of-the-box:
NEO4J_URI=neo4j+s://demo.neo4jlabs.com:7687
NEO4J_USERNAME=companies
NEO4J_PASSWORD=companies
NEO4J_DATABASE=companies
# Optional Aura metadata for external deployment tooling. The application uses
# the NEO4J_* settings above to connect.
AURA_INSTANCEID=
AURA_INSTANCENAME=

# ── Neo4j Agent Memory Server (NAMS) — optional ──────────────────────────────
# Cross-session long-term memory & shared multi-agent context graph.
# Leave blank to run crew with native local execution without NAMS.
# Get API key & workspace ID at https://memory.neo4jlabs.com
MEMORY_API_KEY=
MEMORY_WORKSPACE_ID=

# ── Local MCP (Model Context Protocol) — optional ────────────────────────────
# Start the official Neo4j MCP server locally over stdio. Install it with
# `pip install -e ".[mcp]"`. Leave blank to disable MCP tool loading.
MCP_SERVER_COMMAND=neo4j-mcp-server
#
# The integration's NEO4J_* settings are forwarded automatically. Set these
# only to use a different database for MCP tools.
# NEO4J_MCP_URI=
# NEO4J_MCP_USERNAME=
# NEO4J_MCP_PASSWORD=
# NEO4J_MCP_DATABASE=
NEO4J_MCP_READ_ONLY=true
NEO4J_TELEMETRY=false

# ── CrewAI Execution Settings ────────────────────────────────────────────────
CREW_VERBOSE=true
CREW_PROCESS=sequential
