# ── DataRobot ────────────────────────────────────────────────────────────────
# Required for deployment (infra/agent.py deploy command)
DATAROBOT_ENDPOINT=https://app.datarobot.com
DATAROBOT_API_TOKEN=your-datarobot-api-token
# Optional: override the model name created in DataRobot (default: "Neo4j DataRobot Agent")
DR_MODEL_NAME=Neo4j DataRobot Agent
# Set after deploying — used by the notebook to call the live Chat endpoint
# DR_DEPLOYMENT_ID=your-deployment-id-here

# ── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Optional: override OpenAI base URL (e.g. DataRobot LLM proxy, Azure OpenAI, local server)
# OPENAI_BASE_URL=https://your-endpoint/v1

# ── Neo4j (public demo DB — ready to use) ────────────────────────────────────
NEO4J_URI=neo4j+s://demo.neo4jlabs.com:7687
NEO4J_USERNAME=companies
NEO4J_PASSWORD=companies
NEO4J_DATABASE=companies

# ── Agent Memory (NAMS) — optional; leave blank to disable ───────────────────
# Get your key and workspace ID at https://memory.neo4jlabs.com
# MEMORY_WORKSPACE_ID is the segment between the first two underscores in your key:
#   e.g. nams_<WORKSPACE_ID>_<secret>  →  MEMORY_WORKSPACE_ID=<WORKSPACE_ID>
MEMORY_API_KEY=your-nams-api-key
MEMORY_WORKSPACE_ID=your-workspace-id

# ── MCP — optional; connect to any MCP server for extra tools ────────────────
# Leave MCP_SERVER_URL blank to disable MCP.
# Transport is auto-detected: Streamable HTTP → SSE → stdio
#
# Examples:
#   HTTP server:            MCP_SERVER_URL=https://neo4j-mcp-official-1008050579172.us-central1.run.app/mcp
#   SSE server:             MCP_SERVER_URL=http://localhost:3001/sse
#   stdio command:          MCP_SERVER_URL=uvx neo4j-agent-memory[mcp] mcp serve --password secret
#   Aura Agent (hosted):    MCP_SERVER_URL=<the public MCP endpoint shown on the Aura Agent's page>
#   Aura hosted database:   MCP_SERVER_URL=<the MCP URL from the Aura Console "Inspect" tab for that instance>
MCP_SERVER_URL=

# MCP auth — choose ONE of the following (checked in this priority order):
#
# 1) Aura Agents / Aura Management API — OAuth 2.0 client-credentials grant.
#    Create API credentials from the Aura Console ("API keys" / "Client
#    credentials" section) to get a client ID/secret pair, then set:
MCP_OAUTH_CLIENT_ID=
MCP_OAUTH_CLIENT_SECRET=
#    Optional overrides (only needed if the Aura Agent's setup screen shows a
#    different token endpoint, scope, or audience than the default below):
#      MCP_OAUTH_TOKEN_URL default: https://api.neo4j.io/oauth/token
MCP_OAUTH_TOKEN_URL=
MCP_OAUTH_SCOPE=
MCP_OAUTH_AUDIENCE=
#
# 2) Any other MCP server that takes a static Bearer token:
MCP_AUTH_TOKEN=
#
# 3) Aura hosted-database MCP URL (Inspect tab), or neo4j-mcp-official: uses
#    NEO4J_USERNAME/NEO4J_PASSWORD above as Basic auth automatically — no
#    extra vars needed here.
#
# 4) Open/unauthenticated server: leave all of the above blank.

# MCP HTTP timeout (seconds) — optional, default 90.
# Increase if your MCP server is reached through a corporate proxy or is a
# cold-starting cloud service; the default has headroom for that plus the
# server's own retry time on tool calls (e.g. Neo4j query execution). This
# timeout is also reused for the OAuth token-fetch request above.
MCP_HTTP_TIMEOUT=

# ── Agent settings ────────────────────────────────────────────────────────────
AGENT_MAX_TOOL_STEPS=6
