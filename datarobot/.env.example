# DataRobot
DATAROBOT_ENDPOINT=https://app.datarobot.com/api/v2
DATAROBOT_API_TOKEN=your-datarobot-api-token

# OpenAI
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Neo4j (public demo DB — ready to use)
NEO4J_URI=neo4j+s://demo.neo4jlabs.com:7687
NEO4J_USERNAME=companies
NEO4J_PASSWORD=companies
NEO4J_DATABASE=companies

# Agent Memory (NAMS) — optional; leave blank to disable memory
# Get your key at https://memory.neo4jlabs.com
MEMORY_API_KEY=your-nams-api-key

# Agent settings
AGENT_MAX_TOOL_STEPS=6
