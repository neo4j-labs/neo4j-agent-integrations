# Model provider
ANTHROPIC_API_KEY="your-anthropic-api-key"

# Public, read-only Neo4j companies demo database
NEO4J_URI="neo4j+s://demo.neo4jlabs.com:7687"
NEO4J_USERNAME="companies"
NEO4J_PASSWORD="companies"
NEO4J_DATABASE="companies"

# Optional Neo4j MCP HTTP endpoint. The MCP connection uses the same
# NEO4J_USERNAME and NEO4J_PASSWORD configured above.
NEO4J_MCP_URL="https://mcp.demo.neo4jlabs.com/mcp"
