{
  "name": "neo4j-flue-example",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "agent": "flue run src/agents/industry-research-agent.ts",
    "check:mcp": "node --env-file-if-exists=.env --experimental-strip-types scripts/check-mcp.ts",
    "mcp-agent": "flue run src/agents/neo4j-mcp-research-agent.ts",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@flue/cli": "^2.0.3",
    "@flue/runtime": "^2.0.3",
    "neo4j-driver": "^6.2.0",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  }
}
